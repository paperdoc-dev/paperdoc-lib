{
    "name": "paperdoc-dev/paperdoc-lib",
    "description": "A zero-dependency PHP library for generating, parsing and converting documents — PDF, DOCX, XLSX, PPTX, HTML, Markdown, CSV and legacy Office formats",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "pdf",
        "html",
        "csv",
        "docx",
        "xlsx",
        "pptx",
        "markdown",
        "document",
        "writer",
        "parser",
        "converter"
    ],
    "authors": [
        {
            "name": "Paperdoc",
            "email": "support@paperdoc.dev"
        }
    ],
    "homepage": "https://paperdoc.dev",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "suggest": {
        "illuminate/support": "^11.0|^12.0 Required for Laravel integration (ServiceProvider, Facade)",
        "ext-curl": "Preferred HTTP transport for the built-in LLM providers (falls back to PHP streams)"
    },
    "autoload": {
        "psr-4": {
            "Paperdoc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Paperdoc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "test": "phpunit --no-coverage"
    },
    "bin": [
        "bin/paperdoc"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Paperdoc\\PaperdocServiceProvider"
            ],
            "aliases": {
                "Paperdoc": "Paperdoc\\Facades\\Paperdoc"
            }
        }
    }
}
